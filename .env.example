# Example .env for local development. Copy to .env and fill in secrets locally.
CONNECTION_STRING=

# Individual parts (optional)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Chinook
DB_USER=sa
# Do NOT commit a real password to source control. Provide DB_PASS via .env or Docker secret.
DB_PASS=
DB_DRIVER=ODBC Driver 18 for SQL Server
TRUST_SERVER_CERT=yes